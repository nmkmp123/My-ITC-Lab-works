//task 4

#include <iostream>
using namespace std;

int main()
{
    int num=0;
    int positive = 0;
    int negative = 0;

    cout << "Enter numbers (0 to stop): ";
    cin >> num;

    while (num != 0)
    {
        if (num > 0)
        {
            positive++;
        }
        else if (num < 0)
        {
            negative++;
        }

        cin >> num;
    }

    cout << "Positive numbers: " << positive << endl;
    cout << "Negative numbers: " << negative << endl;

    return 0;
}
